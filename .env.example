# Copy this file to .env and replace the RFC 5737 documentation addresses.
# Never commit .env or any lab-specific address.

# RH56DFTP Modbus TCP endpoint used by vision control and Open-Teach.
RH56_HOST=192.0.2.10
RH56_PORT=6000

# Workstation address reachable from the Quest headset.
OPENTEACH_HOST=192.0.2.20
