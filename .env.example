# Copy this file to .env and replace the RFC 5737 documentation addresses.
# Never commit .env or any lab-specific address.

# RH56DFTP Modbus TCP endpoint used by vision control and Open-Teach.
RH56_HOST=192.0.2.10
RH56_PORT=6000

# Workstation address reachable from the Quest headset.
OPENTEACH_HOST=192.0.2.20

# macOS default: read the D435 RGB UVC endpoint through AVFoundation.
D435_CAMERA_SOURCE=avfoundation
D435_WIDTH=1280
D435_HEIGHT=720
D435_FPS=30
D435_JPEG_QUALITY=82
D435_CAMERA_INDEX=0
D435_CAMERA_ROTATION=0

# Experimental raw librealsense bridge. It may require a supported host OS and
# direct USB access that current macOS releases do not grant to Homebrew librealsense.
# D435_CAMERA_SOURCE=realsense
# D435_BRIDGE_SOCKET=/tmp/dex-realsense-rgb.sock
# Optional when multiple RealSense devices are connected. Keep real serials in .env.
# D435_SERIAL=000000000000
